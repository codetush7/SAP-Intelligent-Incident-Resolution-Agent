<mvc:View
  controllerName="cpi.incidentagent.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.tnt"
  xmlns:m="sap.m"
  displayBlock="true">
  <ToolPage id="toolPage">
    <header>
      <ToolHeader>
        <m:Button icon="sap-icon://menu2" press=".onToggleSideNav" type="Transparent"/>
        <m:Title text="{i18n>appTitle}" level="H3"/>
        <m:ToolbarSpacer/>
        <m:Button icon="sap-icon://bell" type="Transparent" press=".onNotificationsPress">
          <m:layoutData><m:OverflowToolbarLayoutData/></m:layoutData>
        </m:Button>
        <m:ObjectStatus
          text="{= ${app>/wsConnected} ? 'Live' : 'Offline' }"
          state="{= ${app>/wsConnected} ? 'Success' : 'Error' }"
          icon="{= ${app>/wsConnected} ? 'sap-icon://connected' : 'sap-icon://disconnected' }"
          class="sapUiSmallMarginBegin sapUiSmallMarginEnd"/>
        <m:Avatar initials="{app>/user/initials}" displaySize="XS" press=".onUserPress"/>
      </ToolHeader>
    </header>
    <sideContent>
      <SideNavigation id="sideNav" selectedKey="{app>/activePage}" itemSelect=".onNavItemSelect">
        <NavigationList>
          <NavigationListItem text="{i18n>navDashboard}" key="dashboard" icon="sap-icon://home"/>
          <NavigationListItem text="{i18n>navMonitoring}" key="monitoring" icon="sap-icon://it-system"/>
          <NavigationListItem text="{i18n>navIncidents}" key="incidents" icon="sap-icon://alert"/>
          <NavigationListItem text="{i18n>navTenants}" key="tenants" icon="sap-icon://connected"/>
        </NavigationList>
        <fixedItem>
          <NavigationList>
            <NavigationListItem text="{i18n>navLogout}" key="logout" icon="sap-icon://log"/>
          </NavigationList>
        </fixedItem>
      </SideNavigation>
    </sideContent>
    <mainContents>
      <m:NavContainer id="app"/>
    </mainContents>
  </ToolPage>
</mvc:View>
