# ─── GROQ AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=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
GROQ_MODEL=llama-3.1-8b-instant

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── SAP BTP TRIAL CPI ────────────────────────────────────────────────────────
# No longer required here — connect tenants at runtime via the "Tenant Connect"
# page in the app (one-click connect: Tenant URL, Token URL, Client ID, Secret).
# These vars are kept only as a fallback if no tenant has been added yet.
SAP_CPI_BASE_URL=https://your-tenant.it-cpi.cfapps.sap.hana.ondemand.com
SAP_CPI_CLIENT_ID=sb-your-client-id-here
SAP_CPI_CLIENT_SECRET=your-client-secret-here
SAP_CPI_TOKEN_URL=https://your-subaccount.authentication.sap.hana.ondemand.com/oauth/token

# ─── TENANT SECRET ENCRYPTION ─────────────────────────────────────────────────
# Used to encrypt SAP CPI client secrets saved via Tenant Connect before storing
# them. Set this to a long random string in production.
TENANT_ENCRYPTION_KEY=change-me-to-a-long-random-string

# ─── SERVICENOW DEVELOPER INSTANCE ───────────────────────────────────────────
# Found at: https://developer.servicenow.com > My Instance
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-servicenow-password

# ─── MONITORING CONFIG ────────────────────────────────────────────────────────
MONITORING_INTERVAL_SECONDS=60
CERT_EXPIRY_WARNING_DAYS=30
QUEUE_SIZE_THRESHOLD=1000
