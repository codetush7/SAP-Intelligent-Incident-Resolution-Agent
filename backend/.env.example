# ─── GROQ / GEMINI AI PROVIDER ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── DATABASE CONFIGURATION (SAP HANA CLOUD) ──────────────────────────────────
# DB_TYPE: 'hana' | 'memory' (defaults to 'hana' if HANA_HOST is set, else 'memory')
DB_TYPE=hana
HANA_HOST=your-hana-cloud-instance.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=your_hana_password_here
HANA_SCHEMA=DBADMIN
HANA_ENCRYPT=true
HANA_SSL_VALIDATE_CERTIFICATE=false

# ─── SECURITY, ENCRYPTION & JWT ───────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRES_IN=10m
ENCRYPTION_KEY=your_aes_256_encryption_key_change_me
TENANT_ENCRYPTION_KEY=your_aes_256_encryption_key_change_me

# ─── SAP BTP TRIAL CPI (FALLBACK) ──────────────────────────────────────────────
# Connect tenants dynamically via "Tenant Connect" in the web UI.
# Fallback vars:
SAP_CPI_BASE_URL=https://your-tenant.it-cpi.cfapps.sap.hana.ondemand.com
SAP_CPI_CLIENT_ID=sb-your-client-id-here
SAP_CPI_CLIENT_SECRET=your-client-secret-here
SAP_CPI_TOKEN_URL=https://your-subaccount.authentication.sap.hana.ondemand.com/oauth/token

# ─── SERVICENOW DEVELOPER INSTANCE ───────────────────────────────────────────
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-servicenow-password

# ─── MONITORING CONFIG ────────────────────────────────────────────────────────
MONITORING_INTERVAL_SECONDS=60
CERT_EXPIRY_WARNING_DAYS=30
QUEUE_SIZE_THRESHOLD=1000
